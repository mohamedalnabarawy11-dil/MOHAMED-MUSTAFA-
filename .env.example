# OPENROUTER_API_KEY: Required for live OpenRouter API (openrouter/free) calls.
# Configure this value securely in the Secrets panel in AI Studio.
# If left at default or empty, the app automatically runs in Smart Demo Mode.
OPENROUTER_API_KEY=MY_OPENROUTER_API_KEY

# GEMINI_API_KEY: Unused (this app uses OpenRouter API).
# GEMINI_API_KEY=MY_GEMINI_API_KEY
